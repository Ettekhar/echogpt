# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_PUBLIC_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echogpt?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_strong_secret
JWT_REFRESH_EXPIRES_IN=7d

# Encryption for stored provider API keys (32-byte hex key)
PROVIDER_KEY_ENCRYPTION_SECRET=replace_with_32_byte_hex_key

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email (bonus - email verification)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@echogpt.app

# Free plan usage limit (requests per day)
FREE_PLAN_DAILY_LIMIT=20
PREMIUM_PLAN_DAILY_LIMIT=1000

# Web Search (choose one provider and set its key)
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
